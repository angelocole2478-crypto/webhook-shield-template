# Required: PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/webhooks
# Required: Redis connection string
REDIS_URL=redis://host:6379
# Required: HTTP endpoint used by the demo destination
DELIVERY_URL=https://example.com/receiver
# Required: secret accepted by POST /webhooks
INGEST_SECRET=replace-with-a-long-random-secret
# Optional: secret for GET /events/:id
MONITOR_SECRET=replace-with-another-secret
# Optional: retry count (default 3)
MAX_ATTEMPTS=3
# Optional: delete events and attempts older than this many days (default 14)
RETENTION_DAYS=14
# Railway supplies PORT; local default is 3000
PORT=3000
